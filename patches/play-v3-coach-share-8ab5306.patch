+                tab.textContent = label; tabs.appendChild(tab);
+                const panel = node('section', 'caissa-play-share__panel', {
+                    role: 'tabpanel', 'data-share-panel': id, id: `caissa-share-panel-${id}`,
+                    'aria-labelledby': `caissa-share-tab-${id}`
