 }
 
-function isNativeCoachGame() {
+function isAssistedLocalEngineGame() {
     const route = window.CaissaPlayRouteController?.getCurrent?.();
-    const shellCoach = document.querySelector('.caissa-simplified-shell[data-mode="coach"]');
