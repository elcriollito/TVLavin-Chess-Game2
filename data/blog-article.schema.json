{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAISSA Chess editorial article",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "title", "seoTitle", "description", "excerpt", "category", "tags", "author",
    "publishedDate", "modifiedDate", "featuredImage", "featuredImageAlt", "featuredImageWidth", "featuredImageHeight",
    "body", "relatedArticleSlugs", "relatedCaissaRoute", "status"
  ],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 20, "maxLength": 90},
    "seoTitle": {"type": "string", "minLength": 30, "maxLength": 60},
    "description": {"type": "string", "minLength": 80, "maxLength": 160},
    "excerpt": {"type": "string", "minLength": 80, "maxLength": 240},
    "category": {"type": "string", "minLength": 2},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "author": {"const": "CAISSA Chess Editorial"},
    "publishedDate": {"type": "string", "format": "date"},
    "modifiedDate": {"type": ["string", "null"], "format": "date"},
    "featuredImage": {"type": "string", "pattern": "^/"},
    "featuredImageAlt": {"type": "string", "minLength": 20, "maxLength": 180},
    "featuredImageWidth": {"type": "integer", "minimum": 600},
    "featuredImageHeight": {"type": "integer", "minimum": 400},
    "introduction": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 80}
    },
    "body": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "paragraphs"],
        "properties": {
          "heading": {"type": "string", "minLength": 4},
          "subheading": {"type": "string"},
          "paragraphs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 80}},
          "orderedList": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 10}}
        }
      }
    },
    "relatedArticleSlugs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "relatedCaissaRoute": {"type": "string", "pattern": "^/"},
    "ctaHeading": {"type": "string", "minLength": 4},
    "ctaText": {"type": "string", "minLength": 20},
    "ctaLabel": {"type": "string", "minLength": 4},
    "status": {"enum": ["draft", "published"]}
  }
}
