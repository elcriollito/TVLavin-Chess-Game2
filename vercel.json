{
  "functions": {
    "api/stripe/webhook.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    { "source": "/", "destination": "/play", "permanent": true },
    { "source": "/blog/", "destination": "/blog", "permanent": true },
    { "source": "/blog/:slug/", "destination": "/blog/:slug", "permanent": true },
    { "source": "/yahoo-classic/", "destination": "/yahoo-classic", "permanent": true },
    { "source": "/play/beta", "destination": "/play", "permanent": true },
    { "source": "/play/beta/games", "destination": "/play/games", "permanent": true },
    { "source": "/play/beta/bots", "destination": "/play/bots", "permanent": true },
    { "source": "/play/beta/coach", "destination": "/play/coach", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/endgame-trainer", "destination": "/endgame-trainer.html" },
    { "source": "/endgame-trainer/", "destination": "/endgame-trainer.html" },
    { "source": "/endgame-practice", "destination": "/endgame-practice.html" },
    { "source": "/endgame-practice/", "destination": "/endgame-practice.html" },
    { "source": "/endgame-library", "destination": "/endgame-library.html" },
    { "source": "/endgame-library/", "destination": "/endgame-library.html" },
    { "source": "/eco", "destination": "/eco.html" },
    { "source": "/eco/:code", "destination": "/eco.html" },
    { "source": "/database", "destination": "/database.html" },
    { "source": "/database/eco/:code", "destination": "/database.html" },
    { "source": "/tools/polyglot", "destination": "/polyglot.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/premium", "destination": "/premium.html" },
    { "source": "/vault", "destination": "/vault.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/yahoo-classic", "destination": "/yahoo-classic.html" },
    { "source": "/play-online/playchess", "destination": "/playchess.html" },
    { "source": "/play-online/fritz", "destination": "/fritz.html" },
    { "source": "/puzzles/chessbase-tactics", "destination": "/tactics.html" },
    { "source": "/watch/live-blitz", "destination": "/live-blitz.html" },
    { "source": "/watch/live-tournaments", "destination": "/live-tournaments.html" },
    { "source": "/watch/game-replayer", "destination": "/game-replayer.html" },
    { "source": "/academy", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/fics", "destination": "/index.html" },
    { "source": "/analyze", "destination": "/index.html" },
    { "source": "/spectator-tv", "destination": "/index.html" },
    { "source": "/arena", "destination": "/index.html" },
    { "source": "/cheater-insight", "destination": "/index.html" },
    { "source": "/game-library", "destination": "/index.html" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/dos-chess", "destination": "/index.html" },
    { "source": "/play/beta/invite", "destination": "/play-v2-unavailable.html" },
    { "source": "/play/beta/:path*", "destination": "/play-v2-unavailable.html" },
    { "source": "/play-v2-invite.html", "destination": "/play-v2-unavailable.html" },
    { "source": "/play-v2.html", "destination": "/play-v2-unavailable.html" },
    { "source": "/play-v2-public-beta.html", "destination": "/play-v2-unavailable.html" },
    { "source": "/play-v2-promotion-qa.html", "destination": "/play-v2-unavailable.html" },
    { "source": "/play-v2-ipad-analyze-diagnostic.html", "destination": "/play-v2-unavailable.html" },
    { "source": "/supabase/:path*", "destination": "/play-v2-unavailable.html" },
    { "source": "/play", "destination": "/play-v2-unavailable.html" },
    { "source": "/play/:mode", "destination": "/play-v2-unavailable.html" },
    { "source": "/opening-database", "destination": "/opening-database.html" },
    { "source": "/opening-database/", "destination": "/opening-database.html" },
    { "source": "/openingdb/manifest.json", "destination": "https://downloads.caissa-chess.org/openingdb/manifest.json" },
    { "source": "/openingdb/shards/:path*", "destination": "https://downloads.caissa-chess.org/openingdb/shards/:path*" },
    { "source": "/openingdb/:path*", "destination": "https://downloads.caissa-chess.org/openingdb/:path*" },
    { "source": "/gamesearch/:path*", "destination": "https://downloads.caissa-chess.org/gamesearch/:path*" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/data/:path*", "destination": "/public/data/:path*" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/favicon-16.png", "destination": "/public/favicon-16.png" },
    { "source": "/favicon-32.png", "destination": "/public/favicon-32.png" },
    { "source": "/apple-touch-icon.png", "destination": "/public/apple-touch-icon.png" },
    { "source": "/icon-192.png", "destination": "/public/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/public/icon-512.png" },
    { "source": "/icon-master.svg", "destination": "/public/icon-master.svg" },
    { "source": "/manifest.json", "destination": "/public/manifest.json" },
    { "source": "/robots.txt", "destination": "/public/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/public/sitemap.xml" },
    { "source": "/caissa-indexnow-2026.txt", "destination": "/public/caissa-indexnow-2026.txt" },
    { "source": "/og-image.png", "destination": "/public/og-image.png" },
    { "source": "/favicon-test.html", "destination": "/public/favicon-test.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://code.jquery.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://*.clerk.accounts.dev https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: blob: https://img.clerk.com https://images.clerk.dev https://cdn.jsdelivr.net https://chessboardjs.com https://c.bing.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com; connect-src 'self' https://api.chess.com https://lichess.org https://caissa-game-fetcher.elcriollito.workers.dev wss://fics-gateway.caissa-chess.org https://*.clerk.accounts.dev https://api.clerk.com https://clerk-telemetry.com https://c.bing.com https://api.together.xyz https://api.llama.com https://api.openai.com https://api.anthropic.com; worker-src 'self'; frame-src 'self' https://play.chessbase.com https://fritz.chessbase.com https://livetactics.chessbase.com https://liveblitz.chessbase.com https://live.chessbase.com https://*.clerk.accounts.dev https://challenges.cloudflare.com https://checkout.stripe.com https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" }
      ]
    },
    {
      "source": "/integrations/chessbase-pgn-replayer.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self' 'unsafe-eval' https://pgn.chessbase.com; style-src 'self' 'unsafe-inline' https://pgn.chessbase.com; img-src data: blob: https://pgn.chessbase.com; connect-src https://www.caissa-chess.org; font-src data: https://pgn.chessbase.com https://fonts.gstatic.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), clipboard-read=(), clipboard-write=()" }
      ]
    },
    {
      "source": "/data/pgn/capablanca-games-1901-1941.pgn",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/play",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "index, follow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/play/:path*",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; worker-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|icon-.*|manifest.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
