{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/eae011.js": { "maxDuration": 60 },
    "api/cron/eae015a-lc0-cleanup.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron/eae015a-lc0-cleanup", "schedule": "*/10 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/eae011", "dest": "/api/eae011.js" },
    { "src": "/api/cron/eae015a-lc0-cleanup", "dest": "/api/cron/eae015a-lc0-cleanup.js" },
    { "src": "/health", "dest": "/api/eae011.js?action=health" },
    { "src": "/.*", "status": 404 }
  ]
}
