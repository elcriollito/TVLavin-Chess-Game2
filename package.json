{
  "name": "tvlavin-chess",
  "version": "1.0.0",
  "description": "TVLavin Chess - Full-featured chess application",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "download-pgn": "node tools/fetch-pgnmentor.mjs",
    "download-pgn-test": "node tools/fetch-pgnmentor.mjs --test",
    "download-pgn-force": "node tools/fetch-pgnmentor.mjs --force",
    "indexnow-ping": "node tools/indexnow-ping.mjs",
    "dos:scrape-chess": "node tools/scrape-dosgamesarchive-chess.mjs",
    "dos:scrape-chess-force": "node tools/scrape-dosgamesarchive-chess.mjs --force",
    "dos:scrape-chess-dry": "node tools/scrape-dosgamesarchive-chess.mjs --dry-run",
    "build:eco-position-map": "node scripts/build-eco-position-map.js --out public/data/eco/eco_position_map.json",
    "build:opening-book": "node scripts/build-opening-book.js --pgnDir data/pgn --outDir public/data/book_chunks --maxPlies 16",
    "build:openingdb": "node scripts/build-openingdb-index.js --in data/pgn_db --out data/openingdb/shards",
    "upload:openingdb:r2": "node scripts/upload-openingdb-shards-r2.js --dir data/openingdb/shards --version v1",
    "test:opening-known-lines": "node scripts/verify-known-lines.js",
    "fics:gateway": "node server/fics-gateway.cjs",
    "fics:dev": "node server/fics-gateway.cjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.29.5",
    "@supabase/supabase-js": "^2.93.1",
    "adm-zip": "^0.5.10",
    "chess-openings": "^0.1.1",
    "chess.js": "^1.4.0",
    "js-dos": "^8.3.20",
    "stripe": "^20.2.0",
    "ws": "^8.19.0"
  },
  "author": "TVLavin",
  "license": "MIT",
  "devDependencies": {
    "cheerio": "^1.2.0",
    "sharp": "^0.34.5"
  }
}
